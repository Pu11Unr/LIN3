# ==============================
# Configuration NTP Windows
# ==============================

# Source NTP principale (pas l'adresse IP locale de Windows)
NTP_PRIMARY_SERVER=10.229.38.101

# Source NTP externe de secours
NTP_BACKUP_SERVER=ch.pool.ntp.org

# Plage autorisee dans le pare-feu Windows
NTP_ALLOWED_SUBNET=LocalSubnet

# Intervalles NTP (puissances de 2 en secondes)
NTP_MIN_POLL_INTERVAL=6
NTP_MAX_POLL_INTERVAL=6

# Parametre d'ajustement de l'horloge Windows
NTP_UPDATE_INTERVAL=100
