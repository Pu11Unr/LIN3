# LIN3 - Windows NTP - Site configuration
# Copy to .env.windows.txt before execution.
# The local Windows hostname and IP address are NOT modified.

# ===== A MODIFIER SELON LE SITE =====
# Swiss time zone (Europe/Zurich)
TZ_NAME=W. Europe Standard Time

# Internal Linux NTP server (confirm the address with your group)
NTP_PRIMARY_SERVER=10.0.2.10

# External backup NTP servers, space-separated; 0xA = client + fallback-only
NTP_SERVERS=

# Regional NTP pool (also configured as fallback-only)
NTP_POOL=ie.pool.ntp.org

# Allowed NTP client addresses for Windows inbound UDP 123
# Only clients within 10.0.2.0/28 may query the Windows NTP server.
NTP_ALLOWED_SUBNET=10.0.2.0/28

# ===== PARAMETRES DU SERVICE =====
NTP_MIN_POLL_INTERVAL=6
NTP_MAX_POLL_INTERVAL=6
NTP_UPDATE_INTERVAL=100
NTP_ANNOUNCE_FLAGS=10
NTP_EVENT_LOG_FLAGS=3
NTP_DISABLE_VMIC=1
NTP_MAX_ROOT_DISTANCE=5
NTP_INSTALL_WAIT_SECONDS=300
